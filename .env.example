# Basis-URL der App (https => Session-Cookie mit secure-Flag)
# Docker/Produktion: https://video.DEINEDOMAIN.de
APP_URL=http://localhost:3000
# Passwort für den Admin-Zugang
ADMIN_PASSWORD=
# Geheimnis für Session-Signatur (min. 32 Zeichen), z. B. `openssl rand -hex 32`
SESSION_SECRET=
# 64 Hex-Zeichen = 32 Byte für AES-256-GCM, z. B. `openssl rand -hex 32`
ENCRYPTION_KEY=
# Salt für gehashte IP-Adressen
IP_HASH_SALT=
# Datenverzeichnis (DB + Medien). Docker: /data – docker-compose.yml setzt den Wert selbst (Host: ./data)
DATA_DIR=./data
# Lokaler Host-Port der App (nur 127.0.0.1), Standard 3000
# APP_PORT=3000
# Anzahl paralleler Render-Jobs
RENDER_CONCURRENCY=1
# Optional: neue Render-Jobs nur in diesem Zeitfenster (Berlin) starten, z. B. nachts 00:00-07:00. Leer = immer.
RENDER_WINDOW=
# ffmpeg-Binary für das Zusammenfügen von Intro + Teaser (Docker-Image installiert ffmpeg). ffprobe wird nicht benötigt.
FFMPEG_PATH=ffmpeg
# Optional: Pfad zu Chrome/Chromium/headless_shell für das Rendern. Leer = Remotion lädt beim ersten Render
# selbst chrome-headless-shell herunter (braucht Internetzugang). Nützlich in Umgebungen ohne Download.
# Docker: leer lassen – das Image bringt chrome-headless-shell bereits mit.
REMOTION_BROWSER_EXECUTABLE=
# Google OAuth (Gmail-Versand)
# Hinweis Docker: .env gilt für beide Container (app + worker); nach Änderungen `docker compose up -d`.
# Werte mit $ oder # in Anführungszeichen setzen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Produktion: https://video.DEINEDOMAIN.de/api/gmail/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
# Absender
SENDER_EMAIL=Amin.douioui@prozessia.de
SENDER_NAME=
# Standard-Termin-Link für neue Kampagnen
DEFAULT_CTA_URL=https://calendly.com/sebastian-spuhler/30min
# Rechtliche Seiten (Footer der Video-Seite)
IMPRESSUM_URL=
DATENSCHUTZ_URL=
# Zufälliger Abstand zwischen zwei Mails (Minuten)
SEND_MIN_GAP_MINUTES=3
SEND_MAX_GAP_MINUTES=9
# Optional: KI-Funktionen (Antworten einordnen, Schreibhilfe, Antwort-Entwurf). Ohne Schlüssel sind sie aus und unsichtbar.
# Die Schlüssel (und OPENAI_MODEL / JEV_MODELL) trägt man bevorzugt in der App ein: Einstellungen → KI (verschlüsselt gespeichert, hat Vorrang).
# Die Variablen hier sind die Alternative, z. B. für automatisierte Installationen.
# Achtung Datenschutz: Mailtexte gehen dabei an Anthropic (vorher AVV/DPA abschließen, siehe README).
ANTHROPIC_API_KEY=
# Modelle (optional): Schreibhilfe/Antwort-Entwurf und Klassifikation
ANTHROPIC_MODEL_SCHREIBEN=claude-sonnet-5-5
ANTHROPIC_MODEL_KLASSIFIZIEREN=claude-haiku-5-5
# Optional: Jev (TypeSafe AI) direkt über die TypeSafe-API (Schlüssel von console.typesafe.ai; in der App: Einstellungen → KI → „TypeSafe (Jev, direkt)“).
# Hat Vorrang vor OpenRouter. Achtung Datenschutz: Mailtexte gehen an TypeSafe (USA), AVV prüfen.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_JEV_MODELL=jev-latest
# Optional: Jev (TypeSafe AI, über OpenRouter) als Klassifizierer für „Antworten einordnen“. Reicht allein aus (ohne ANTHROPIC_API_KEY);
# Schreibhilfe und Antwort-Entwurf brauchen weiterhin den Anthropic-Schlüssel. Achtung Datenschutz: Mailtexte gehen an OpenRouter/TypeSafe (USA), AVV prüfen.
OPENROUTER_API_KEY=
# Optional: OpenAI für Antwort-Entwürfe und Schreibhilfe (statt Anthropic). Mailtexte gehen an OpenAI (USA), AVV prüfen.
# Bei „model not found“ OPENAI_MODEL anpassen (platform.openai.com/docs/models).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=https://api.openai.com/v1
# Nur für den OpenRouter-Zugang (Schlüssel sk-or-…):
JEV_MODELL=typesafe/jev-1.13
JEV_BASE_URL=https://openrouter.ai/api
# Optional: Brain (Second Brain) als Kontextquelle für Antwort-Entwürfe; alternativ in der App unter Einstellungen → Integrationen → Brain.
# BRAIN_API_TOKEN = Wert von EXTERN_API_TOKEN im Brain. Der Kontext geht beim Entwurf an den gewählten KI-Anbieter (Datenschutz).
BRAIN_URL=
BRAIN_API_TOKEN=
# Optional: Webhook-Ziele im lokalen/privaten Netz erlauben (nur für Tests/Intranet; Standard aus = SSRF-Schutz)
WEBHOOK_PRIVATE_ERLAUBT=

# Optional: Lead-Generierung (Daten-Pipeline). Schlüssel trägt man bevorzugt in der App ein; die Variablen sind die Alternative.
# Websuche (Domain-Ermittlung, Personensuche) über die Brave Search API
BRAVE_SEARCH_API_KEY=
# E-Mail-Prüfdienst (check-if-email-exists/Reacher) auf einem Host mit offenem Port 25, NICHT über die IP der Versand-Domain
REACHER_URL=
# Optional: Zugangsschlüssel des Prüfdienstes (wird als Authorization- und x-reacher-secret-Header gesendet)
REACHER_API_KEY=
# 1 = Handelsregister-/Bundesanzeiger-Abruf freigeben (erst nach Prüfung der Nutzungsbedingungen; standardmäßig aus, der Abruf selbst ist nicht eingebaut)
LEADGEN_HR_LIVE=
LEADGEN_BA_LIVE=
# User-Agent des Crawlers (mit Kontaktadresse, damit Seitenbetreiber uns erreichen können)
LEADGEN_CRAWL_UA=ProzessiaLeadBot/1.0 (+mailto:kontakt@prozessia.de)
# Kleines Modell für die Extraktion (leer = OPENAI_MODEL) und optionale Preise in Cent je 1 Mio. Token für die Kostenanzeige
LEADGEN_EXTRAKTION_MODELL=
LEADGEN_LLM_PREIS_EIN=
LEADGEN_LLM_PREIS_AUS=
