# Basis-URL der App (https => Session-Cookie mit secure-Flag)
# Docker/Produktion: https://video.DEINEDOMAIN.de
APP_URL=http://localhost:3000
# Passwort für den Admin-Zugang
ADMIN_PASSWORD=
# Geheimnis für Session-Signatur (min. 32 Zeichen), z. B. `openssl rand -hex 32`
SESSION_SECRET=
# 64 Hex-Zeichen = 32 Byte für AES-256-GCM, z. B. `openssl rand -hex 32`
ENCRYPTION_KEY=
# Salt für gehashte IP-Adressen
IP_HASH_SALT=
# Datenverzeichnis (DB + Medien). Docker: /data – docker-compose.yml setzt den Wert selbst (Host: ./data)
DATA_DIR=./data
# Lokaler Host-Port der App (nur 127.0.0.1), Standard 3000
# APP_PORT=3000
# Anzahl paralleler Render-Jobs
RENDER_CONCURRENCY=1
# Optional: neue Render-Jobs nur in diesem Zeitfenster (Berlin) starten, z. B. nachts 00:00-07:00. Leer = immer.
RENDER_WINDOW=
# ffmpeg-Binary für das Zusammenfügen von Intro + Teaser (Docker-Image installiert ffmpeg). ffprobe wird nicht benötigt.
FFMPEG_PATH=ffmpeg
# Optional: Pfad zu Chrome/Chromium/headless_shell für das Rendern. Leer = Remotion lädt beim ersten Render
# selbst chrome-headless-shell herunter (braucht Internetzugang). Nützlich in Umgebungen ohne Download.
# Docker: leer lassen – das Image bringt chrome-headless-shell bereits mit.
REMOTION_BROWSER_EXECUTABLE=
# Google OAuth (Gmail-Versand)
# Hinweis Docker: .env gilt für beide Container (app + worker); nach Änderungen `docker compose up -d`.
# Werte mit $ oder # in Anführungszeichen setzen.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Produktion: https://video.DEINEDOMAIN.de/api/gmail/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
# Absender
SENDER_EMAIL=Amin.douioui@prozessia.de
SENDER_NAME=
# Standard-Termin-Link für neue Kampagnen
DEFAULT_CTA_URL=https://calendly.com/sebastian-spuhler/30min
# Rechtliche Seiten (Footer der Video-Seite)
IMPRESSUM_URL=
DATENSCHUTZ_URL=
# Zufälliger Abstand zwischen zwei Mails (Minuten)
SEND_MIN_GAP_MINUTES=3
SEND_MAX_GAP_MINUTES=9
