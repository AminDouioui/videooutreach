# Caddyfile für die Variante mit Caddy-Container (deploy/caddy-compose.override.example.yml)
video.DEINEDOMAIN.de {
	encode zstd gzip
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		request_body {
			max_size 6MB
		}
		reverse_proxy app:3000
	}
}
